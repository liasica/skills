{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh\"",
            "async": false
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path // empty' | { read -r f; [ -n \"$f\" ] && python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/check-punct.py\" \"$f\"; } 2>/dev/null; true",
            "timeout": 15,
            "statusMessage": "检查标点规范"
          }
        ]
      }
    ]
  }
}
